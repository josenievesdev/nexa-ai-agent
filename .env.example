DATABASE_URL="postgresql://usuario:password@host:5432/database"

OLLAMA_HOST="http://127.0.0.1:11434"

OLLAMA_MODEL="ministral-3:8b"

# Contexto del modelo. 6144 es el valor estable en una GPU de 8 GB.
OLLAMA_NUM_CTX="6144"

# Límite de una llamada a /api/chat, en milisegundos.
# Generoso a propósito: el arranque en frío del modelo puede tardar
# más de un minuto. Un timeout no se reintenta.
OLLAMA_TIMEOUT_MS="180000"
